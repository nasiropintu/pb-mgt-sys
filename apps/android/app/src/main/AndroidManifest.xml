    <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="P&amp;B Management Sys" android:allowBackup="false" android:usesCleartextTraffic="false">
        <meta-data android:name="com.nasirpintu.creator" android:value="NasirPintu (Mohammad Nasiruddin Pintu)" />
        <meta-data android:name="com.nasirpintu.tagline" android:value="Crafted with ❤️ by NasirPintu" />
