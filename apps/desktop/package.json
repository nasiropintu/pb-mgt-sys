{
  "name": "pblos-windows-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Private personal and business management workspace",
  "author": "NasirPintu <https://github.com/nasiropintu>",
  "homepage": "https://github.com/nasiropintu",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node ../../node_modules/typescript/bin/tsc -b && node ../../node_modules/vite/bin/vite.js build",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:build": "npm run build && node ../../node_modules/electron-builder/cli.js"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": {
    "@types/node": "^22.18.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0", "electron": "39.8.10", "electron-builder": "^26.0.0",
    "typescript": "~5.9.0", "vite": "^7.1.0", "wait-on": "^8.0.0"
  },
  "build": { "appId": "com.nasirpintu.pblos.worker", "productName": "P&B Management Sys", "directories": { "output": "release" }, "files": ["dist/**/*", "electron/**/*"], "win": { "target": "nsis" } }
}
