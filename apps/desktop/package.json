{
  "name": "pblos-windows-worker",
  "version": "1.1.0",
  "private": true,
  "description": "Personal & Business Life Management System — Private life & work organizer",
  "author": "NasirPintu <https://github.com/nasiropintu>",
  "homepage": "https://github.com/nasiropintu",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node ../../node_modules/typescript/bin/tsc -b && node ../../node_modules/vite/bin/vite.js build",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:build": "npm run build && node ../../node_modules/electron-builder/cli.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "39.8.10",
    "electron-builder": "^26.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.nasirpintu.pbmgt.worker",
    "productName": "P&B MGT Sys",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
